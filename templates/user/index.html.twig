{% extends 'base.html.twig' %}

{% block title %}Usuários - Surpreenda Pet{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('styles/user/user.css') }}">
{% endblock %}

{% block body %}
<div class="user-page">
    <h1 class="page-title">Usuários</h1>
    <p class="page-subtitle">Gestão de usuários</p>

    <div class="user-list">
        <div class="user-card">
            <div class="user-avatar"></div>
            <div class="user-info">
                <h3 class="user-name">Nome do Usuário</h3>
                <span class="user-email">usuario@email.com</span>
                <span class="user-role">ROLE_USER</span>
            </div>
            <a href="#" class="btn-secondary">Editar</a>
        </div>
        <div class="user-card">
            <div class="user-avatar"></div>
            <div class="user-info">
                <h3 class="user-name">Nome do Usuário</h3>
                <span class="user-email">usuario@email.com</span>
                <span class="user-role">ROLE_ADMIN</span>
            </div>
            <a href="#" class="btn-secondary">Editar</a>
        </div>
    </div>
</div>
{% endblock %}
