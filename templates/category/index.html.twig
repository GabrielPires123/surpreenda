{% extends 'base.html.twig' %}

{% block title %}Categorias - Surpreenda Pet{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('styles/category/category.css') }}">
{% endblock %}

{% block body %}
<div class="category-page">
    {{ include('components/breadcrumb.html.twig', {
        items: [
            { label: 'Início', url: path('home_index') },
            { label: 'Categorias' }
        ]
    }) }}

    <div class="category-header">
        <div>
            <h1 class="category-title">Categorias</h1>
            <p class="category-subtitle">Explore por tipo de produto</p>
        </div>
        {% if categorias|length > 0 %}
        <span class="category-count">{{ categorias|length }} categoria{{ categorias|length > 1 ? 's' : '' }}</span>
        {% endif %}
    </div>

    {% if categorias is empty %}
        <div class="category-empty">
            <svg width="64" height="64" viewBox="0 0 64 64" fill="none"><rect x="12" y="12" width="40" height="40" rx="8" stroke="var(--color-border)" stroke-width="2" fill="none"/><path d="M24 28h16M24 36h10" stroke="var(--color-border)" stroke-width="2" stroke-linecap="round"/></svg>
            <p>Nenhuma categoria disponível.</p>
        </div>
    {% else %}
        <div class="category-grid">
            {% for categoria in categorias %}
                <a href="{{ path('product_by_category', {id: categoria.id}) }}" class="category-card">
                    {% if categoria.iconeUrl %}
                        <img src="{{ asset(categoria.iconeUrl) }}" alt="{{ categoria.nome }}" class="category-icon-img">
                    {% else %}
                        <div class="category-icon-letter">{{ categoria.nome|first|upper }}</div>
                    {% endif %}
                    <h3 class="category-name">{{ categoria.nome }}</h3>
                    {% if categoria.descricao %}
                        <p class="category-description">{{ categoria.descricao|slice(0, 80) }}{% if categoria.descricao|length > 80 %}...{% endif %}</p>
                    {% endif %}
                    <span class="category-card-cta">
                        Ver produtos
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 7h8M8 4l3 3-3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                </a>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
