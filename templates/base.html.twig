<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@300;400;600;700;900&family=Outfit:wght@400;600;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('styles/shared.css') }}">
    {% block stylesheets %}{% endblock %}
    <title>{% block title %}Surpreenda Pet{% endblock %}</title>
</head>
<body>
{% block header %}
    {{ include('components/header.html.twig') }}
{% endblock %}

    <main id="main-content" tabindex="-1">
        <div class="toast-container" aria-live="polite" aria-atomic="true" id="toast-container"></div>

        {% set flash_data = [] %}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                {% set flash_data = flash_data|merge([{'type': label, 'message': message}]) %}
            {% endfor %}
        {% endfor %}

        {% if flash_data is not empty %}
            <div id="flash-data" data-flashes='{{ flash_data|json_encode|raw }}' style="display:none;"></div>
        {% endif %}

        {% block body %}{% endblock %}
    </main>

{% block footer %}
    {{ include('components/footer.html.twig') }}
{% endblock %}

{% block javascripts %}
    {{ importmap(['app']) }}
{% endblock %}
</body>
</html>
