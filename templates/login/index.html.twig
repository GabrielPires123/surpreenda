{% extends 'base.html.twig' %}

{% block title %}Entrar - Surpreenda Pet{% endblock %}

{% block header %}{% endblock %}
{% block footer %}{% endblock %}
{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('styles/login/login.css') }}">
{% endblock %}

{% block body %}
<section class="login-page">
    {# Left panel: Branding image #}
    <div class="login-brand" aria-hidden="true">
        <div class="login-brand-overlay"></div>
        <div class="login-brand-content">
            <svg class="login-brand-paw" width="48" height="48" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                <ellipse cx="50" cy="62" rx="22" ry="26" fill="currentColor"/>
                <circle cx="28" cy="32" r="12" fill="currentColor"/>
                <circle cx="72" cy="32" r="12" fill="currentColor"/>
                <circle cx="18" cy="58" r="10" fill="currentColor"/>
                <circle cx="82" cy="58" r="10" fill="currentColor"/>
            </svg>
            <p class="login-brand-quote">"Meu cachorro ama cada caixa. É o melhor presente mensal que já demos!"</p>
            <span class="login-brand-author">— Ana, tutora do Beto</span>
        </div>
    </div>

    {# Right panel: Form #}
    <div class="login-form-side">
        <a href="{{ path('home_index') }}" class="login-logo" aria-label="Surpreenda Pet - Página inicial">
            <svg width="32" height="32" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <ellipse cx="50" cy="62" rx="22" ry="26" fill="currentColor"/>
                <circle cx="28" cy="32" r="12" fill="currentColor"/>
                <circle cx="72" cy="32" r="12" fill="currentColor"/>
                <circle cx="18" cy="58" r="10" fill="currentColor"/>
                <circle cx="82" cy="58" r="10" fill="currentColor"/>
            </svg>
            <span class="logo-text">Surpreenda <span class="logo-accent">Pet</span></span>
        </a>

        <div class="login-form-container">
            <h1 class="login-heading">Bem-vindo de volta</h1>
            <p class="login-subheading">Acesse sua conta para gerenciar sua assinatura e acompanhar seus pedidos.</p>

            {% if error %}
                <div class="login-error" role="alert">
                    <svg class="login-error-icon" width="18" height="18" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V7a1 1 0 00-1-1z" clip-rule="evenodd"/>
                    </svg>
                    <span>{% if error.messageKey is defined %}{{ error.messageKey|trans(error.messageData, 'security') }}{% else %}{{ error.message }}{% endif %}</span>
                </div>
            {% endif %}

            <form class="login-form" method="POST" novalidate>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <div class="login-field">
                    <label for="login-username" class="login-label">E-mail</label>
                    <input
                        type="email"
                        name="username"
                        id="login-username"
                        placeholder="seu@email.com"
                        value="{{ last_username|default('') }}"
                        required
                        autocomplete="email"
                        inputmode="email"
                        aria-describedby="login-username-help"
                    >
                    <small id="login-username-help" class="sr-only">Digite o e-mail cadastrado</small>
                </div>

                <div class="login-field">
                    <div class="login-field-header">
                        <label for="login-password" class="login-label">Senha</label>
                        <a href="{{ path('home_ajuda') }}" class="login-forgot">Esqueceu a senha?</a>
                    </div>
                    <div class="login-password-wrap">
                        <input
                            type="password"
                            name="password"
                            id="login-password"
                            placeholder="Digite sua senha"
                            required
                            autocomplete="current-password"
                            aria-describedby="login-password-help"
                        >
                        <button type="button" class="login-toggle-pw" aria-label="Mostrar senha" data-toggle-pw>
                            <svg class="icon-eye" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                <circle cx="12" cy="12" r="3"/>
                            </svg>
                            <svg class="icon-eye-off" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="display:none">
                                <path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 11-4.24-4.24"/>
                                <line x1="1" y1="1" x2="23" y2="23"/>
                            </svg>
                        </button>
                    </div>
                    <small id="login-password-help" class="sr-only">Digite sua senha de acesso</small>
                </div>

                <button type="submit" class="login-btn">Entrar na Minha Conta</button>
            </form>

            <div class="login-divider">
                <span>ou</span>
            </div>

            <a href="#" class="login-social-btn" aria-label="Continuar com o Google">
                <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
                    <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                    <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.65-2.05.01-.78z" fill="#FBBC05"/>
                    <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                </svg>
                Continuar com o Google
            </a>

            <p class="login-register">Não tem uma conta? <a href="{{ path('cadastro_usuario') }}" class="login-register-link">Crie uma agora e surpreenda seu pet</a></p>
        </div>
    </div>
</section>
{% endblock %}
