<a href="#main-content" class="skip-link">Pular para o conteúdo principal</a>

{% set current_route = app.request.get('_route') %}

<header class="site-header">
    {# LEFT: Logo #}
    <a href="{{ path('home_index') }}" class="header-logo" aria-label="Surpreenda Pet - Página inicial">
        <svg class="header-logo-paw" width="32" height="32" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <ellipse cx="50" cy="62" rx="22" ry="26" fill="currentColor"/>
            <circle cx="28" cy="32" r="12" fill="currentColor"/>
            <circle cx="72" cy="32" r="12" fill="currentColor"/>
            <circle cx="18" cy="58" r="10" fill="currentColor"/>
            <circle cx="82" cy="58" r="10" fill="currentColor"/>
        </svg>
        <span class="logo-text">Surpreenda <span class="logo-accent">Pet</span></span>
    </a>

    {# CENTER: Navigation Links #}
    <nav id="mainNav" class="site-nav" aria-label="Navegação principal">
        <a href="{{ path('home_index') }}" class="nav-link {{ current_route == 'home_index' ? 'nav-link--active' : '' }}">Início</a>
        <a href="{{ path('product_index') }}" class="nav-link {{ current_route == 'product_index' or current_route == 'product_show' ? 'nav-link--active' : '' }}">Produtos</a>
        <a href="{{ path('category_index') }}" class="nav-link {{ current_route == 'category_index' ? 'nav-link--active' : '' }}">Categorias</a>
        <a href="{{ path('kit_index') }}" class="nav-link nav-link--featured {{ current_route == 'kit_index' or current_route == 'kit_show' ? 'nav-link--active' : '' }}">
            Kits
            <span class="nav-badge">Novo</span>
        </a>
    </nav>

    {# RIGHT: Utilities #}
    <div class="nav-utilities">
        {# Cart #}
        <a href="{{ path('carrinho_index') }}" class="nav-utility-btn nav-cart-link" aria-label="Carrinho de compras">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
            <span class="cart-badge" id="cart-badge" aria-live="polite">{{ cartCount ?? 0 }}</span>
        </a>

        {# Search with label #}
        <button class="nav-search-btn search-toggle-btn" id="search-toggle-btn" aria-label="Buscar produtos" aria-expanded="false">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <span class="nav-search-label">Buscar</span>
        </button>

        {# User dropdown or Login CTA #}
        {% if app.user %}
            <div class="nav-dropdown" tabindex="0">
                <button class="nav-utility-btn nav-dropdown-toggle" aria-haspopup="true" aria-expanded="false">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    <span class="nav-username">{{ app.user.firstName ?? 'Usuário' }}</span>
                </button>
                <div class="nav-dropdown-content" role="menu" aria-label="Menu do usuário">
                    <a href="{{ path('perfil_index') }}" class="nav-dropdown-item" role="menuitem">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        Perfil
                    </a>
                    <a href="{{ path('perfil_pets') }}" class="nav-dropdown-item" role="menuitem">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="4" r="2"/><circle cx="18" cy="8" r="2"/><circle cx="4" cy="8" r="2"/><path d="M9 10a3 3 0 0 1 6 0v9a3 3 0 0 1-6 0z"/></svg>
                        Meus Pets
                    </a>
                    <a href="{{ path('pedido_index') }}" class="nav-dropdown-item" role="menuitem">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4zM3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                        Meus Pedidos
                    </a>
                    <a href="{{ path('assinatura_index') }}" class="nav-dropdown-item" role="menuitem">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2z"/><path d="M12 8v4l3 3"/></svg>
                        Minhas Assinaturas
                    </a>
                    <form method="POST" action="{{ path('app_logout') }}" class="logout-form-inline" style="margin:0;padding:0;">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                        <button type="submit" class="nav-dropdown-item nav-dropdown-item--danger" role="menuitem">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg>
                            Sair
                        </button>
                    </form>
                </div>
            </div>
        {% else %}
            <a href="{{ path('home_login') }}" class="nav-cta">Entrar</a>
        {% endif %}

        {# Mobile menu toggle #}
        <button class="nav-mobile-toggle" type="button" id="nav-mobile-toggle" aria-controls="mainNav" aria-expanded="false" aria-label="Abrir menu">
            <span class="nav-mobile-toggle-icon"></span>
        </button>
    </div>

    {# Search Overlay (Desktop) #}
    <div class="search-overlay" id="search-overlay" aria-hidden="true">
        <form action="{{ path('product_index') }}" method="GET" class="search-overlay-form" role="search" aria-label="Buscar produtos">
            <input type="search" name="q" class="search-overlay-input" placeholder="O que o seu pet precisa hoje?" value="{{ app.request.query.get('q') }}" aria-label="Buscar produtos" autocomplete="off">
            <button type="submit" class="search-overlay-submit" aria-label="Buscar">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            </button>
        </form>
        <button class="search-overlay-close" id="search-overlay-close" aria-label="Fechar busca">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
    </div>

    {# Mobile Search Overlay #}
    <div class="search-mobile-overlay" id="search-mobile-overlay">
        <form action="{{ path('product_index') }}" method="GET" class="search-bar-form" role="search" aria-label="Buscar produtos">
            <input type="search" name="q" class="search-bar-input" placeholder="O que o seu pet precisa hoje?" value="{{ app.request.query.get('q') }}" aria-label="Buscar produtos" autocomplete="off">
            <button type="submit" class="search-bar-submit" aria-label="Buscar">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            </button>
        </form>
        <button class="search-mobile-close" id="search-mobile-close" aria-label="Fechar busca">&times;</button>
    </div>

    <span class="sr-only" aria-live="polite" id="cart-live-region"></span>
</header>
