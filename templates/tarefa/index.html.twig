{% extends 'base.html.twig' %}

{% block title %}Tarefas - Surpreenda Pet{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('styles/tarefa/tarefa.css') }}">
{% endblock %}

{% block body %}
<div class="tarefa-container">
    <h2>Minhas Tarefas</h2>
    <a href="#" class="btn-nova-tarefa">+ Nova Tarefa</a>

    <table class="tarefa-table">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Descrição</th>
                <th>Status</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            <tr class="tarefa-row">
                <td>Nome da Tarefa</td>
                <td>Descrição breve da tarefa</td>
                <td><span class="tarefa-status tarefa-status-pendente">Pendente</span></td>
                <td class="tarefa-actions">
                    <a href="{{ path('tarefa_editar') }}" class="btn-editar">Editar</a>
                    <a href="{{ path('tarefa_excluir') }}" class="btn-excluir">Excluir</a>
                </td>
            </tr>
            <tr class="tarefa-row">
                <td>Nome da Tarefa</td>
                <td>Descrição breve da tarefa</td>
                <td><span class="tarefa-status tarefa-status-concluida">Concluída</span></td>
                <td class="tarefa-actions">
                    <a href="{{ path('tarefa_editar') }}" class="btn-editar">Editar</a>
                    <a href="{{ path('tarefa_excluir') }}" class="btn-excluir">Excluir</a>
                </td>
            </tr>
        </tbody>
    </table>
</div>
{% endblock %}
