{% extends 'base.html.twig' %}

{% block title %}Editar Perfil - Surpreenda Pet{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('styles/perfil/editar.css') }}">
{% endblock %}

{% block body %}
<div class="editar-page">
    {{ include('components/breadcrumb.html.twig', {
        items: [
            { label: 'Início', url: path('home_index') },
            { label: 'Perfil', url: path('perfil_index') },
            { label: 'Editar Perfil' }
        ]
    }) }}

    <h1 class="editar-title">Editar Perfil</h1>

    <form method="POST" class="editar-form" novalidate>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('perfil_editar') }}">

        <div class="editar-form-card">
            <div class="editar-form-card-header">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="6" r="3.5" stroke="var(--color-green-sage)" stroke-width="1.5"/><path d="M2.5 16c0-3 3-5.5 6.5-5.5s6.5 2.5 6.5 5.5" stroke="var(--color-green-sage)" stroke-width="1.5" stroke-linecap="round"/></svg>
                <span>Informações Pessoais</span>
            </div>

            <div class="editar-form-group">
                <label for="nome">Nome</label>
                <input type="text" id="nome" name="nome" value="{{ app.user.nome ?? '' }}" required>
            </div>

            <div class="editar-form-group">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" value="{{ app.user.email ?? '' }}" required>
            </div>
        </div>

        <div class="editar-form-card">
            <div class="editar-form-card-header">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><rect x="3" y="8" width="12" height="8" rx="2" stroke="var(--color-green-sage)" stroke-width="1.5"/><path d="M6 8V5.5a3 3 0 0 1 6 0V8" stroke="var(--color-green-sage)" stroke-width="1.5" stroke-linecap="round"/></svg>
                <span>Alterar Senha</span>
            </div>

            <div class="editar-form-group">
                <label for="senha_atual">Senha Atual</label>
                <input type="password" id="senha_atual" name="senha_atual" placeholder="Deixe em branco para não alterar">
            </div>

            <div class="editar-form-group">
                <label for="senha_nova">Nova Senha</label>
                <input type="password" id="senha_nova" name="senha_nova" placeholder="Mínimo 8 caracteres" minlength="8">
            </div>

            <div class="editar-form-group">
                <label for="senha_confirm">Confirmar Nova Senha</label>
                <input type="password" id="senha_confirm" name="senha_confirm" placeholder="Repita a nova senha">
            </div>
        </div>

        <div class="editar-actions">
            <button type="submit" class="editar-btn-salvar">Salvar Alterações</button>
            <a href="{{ path('perfil_index') }}" class="editar-btn-cancelar">Cancelar</a>
        </div>
    </form>
</div>
{% endblock %}
